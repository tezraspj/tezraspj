# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./delivery.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tezraspj

# Admin API (Bearer token for /api/admin/*). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Telegram notifications for new orders (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Misc
SECRET_KEY=
RATE_LIMIT_API=120
RATE_LIMIT_ORDERS=10
